{
  "name": "@j3lte/unidata",
  "version": "1.0.0",
  "exports": {
    ".": "./src/mod.ts"
  },
  "tasks": {
    "generate": "deno run -A --lock deno.dev.lock scripts/generate.ts",
    "test": "deno test -A",
    "prep": "deno fmt && deno lint",
    "prod": "deno task generate && deno task prep",
    "dnt": "deno run -A --lock deno.dev.lock scripts/dnt.ts",
    "publish:test": "deno publish --dry-run --allow-dirty"
  },
  "fmt": {
    "exclude": [
      "**/*.md"
    ],
    "lineWidth": 120,
    "indentWidth": 2
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.42.1",
    "@quentinadam/zip": "jsr:@quentinadam/zip@0.1.1",
    "@std/path": "jsr:@std/path@^1.1.0"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE",
      "deno.json"
    ]
  }
}
